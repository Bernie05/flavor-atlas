# Base URL of the data API (json-server behind the dev server's /api/data gateway)
VITE_API_URL=/api/data

# Admin login (server only). Generate both with: npm run auth:hash
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Claude API key for the AI writing helpers (server only: no VITE_ prefix,
# so it is never bundled into the browser). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
