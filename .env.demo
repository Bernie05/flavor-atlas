# Used by `npm run build:demo` and `npm run dev:mock`: a self-contained build
# for previewing the app without json-server. Data is the bundled seed plus
# changes saved in the artifact's shared database; outside claude.ai (or
# signed out) it falls back to memory. No secrets here.
VITE_DATA_SOURCE=artifact
VITE_ROUTER_MODE=memory
VITE_AI_SOURCE=artifact
VITE_AUTH_SOURCE=artifact
